# Copy this file to .env.local and fill in the two values below.
# Never commit .env.local — it is already covered by .gitignore.

# The deployed Apps Script Web App URL. Must end in /exec (not /dev,
# and not the raw Deployment ID). See apps-script/README.md step 5.
APPS_SCRIPT_WEB_APP_URL=

# The shared secret stored in the Apps Script project's Script Properties
# under the same key (SHARED_SECRET). Generate any long random string.
APPS_SCRIPT_SHARED_SECRET=
